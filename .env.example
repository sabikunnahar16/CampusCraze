# ================== Backend Environment Variables ==================

# Database
DATABASE_URL="postgresql://postgres:password@db:5432/campuscraze"

# Redis
REDIS_URL="redis://redis:6379"

# JWT Authentication
JWT_SECRET="supersecretkey12345_change_this_in_production_2026"

# Node Environment
NODE_ENV=development

# ================== Frontend Environment Variables ==================

# API URL (used by Next.js)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional - For Payment Gateway (Sandbox)
SSL_COMMERZ_STORE_ID=your_store_id
SSL_COMMERZ_STORE_PASSWORD=your_store_password

# Optional - Email Service (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password