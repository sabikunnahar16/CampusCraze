// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String
  role  String  @default("student") // "student", "professor", "admin"
  createdAt DateTime @default(now())
  
  posts Post[]
  courses Enrollment[]
}

model Course {
  id    Int     @id @default(autoincrement())
  title String
  code  String  @unique
  description String?
  createdAt DateTime @default(now())
  
  students Enrollment[]
}

model Enrollment {
  id    Int     @id @default(autoincrement())
  userId Int
  courseId Int
  enrolledAt DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])
  
  @@unique([userId, courseId])
}

model Post {
  id    Int     @id @default(autoincrement())
  title String
  content String
  authorId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  author User @relation(fields: [authorId], references: [id])
}

model Club {
  id Int @id @default(autoincrement())
  slug String @unique
  name String
  slogan String
  category String
  about String
  mission String
  vision String
  achievements Json
  memories Json
  committee Json
  upcomingEvents Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admins AdminUser[]
}

model BusRoute {
  id Int @id @default(autoincrement())
  slug String @unique
  name String
  description String
  keyStops Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WelfareZone {
  id Int @id @default(autoincrement())
  slug String @unique
  name String
  supportFocus String
  contactLine String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id Int @id @default(autoincrement())
  email String @unique
  name String
  passwordHash String
  role String @default("club-admin")
  clubSlug String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club Club? @relation(fields: [clubSlug], references: [slug], onDelete: SetNull)
  sessions AdminSession[]

  @@unique([clubSlug])
}

model AdminSession {
  id Int @id @default(autoincrement())
  tokenHash String @unique
  adminUserId Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
}
